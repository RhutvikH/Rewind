{
  "name": "rewind",
  "displayName": "Rewind",
  "description": "Supercharge your code with easier documentation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rewind",
      "properties": {
        "rewind.intentMarkerColor": {
          "type": "string",
          "default": "rgba(255, 255, 0, 0.2)",
          "description": "Background highlight color for intent markers."
        },
        "rewind.customIntentCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of custom intent categories."
        }
      }
    },
    "commands": [
      {
        "command": "rewind.addIntentMarker",
        "title": "Rewind: Add Intent Marker"
      },
      {
        "command": "rewind.removeIntentMarker",
        "title": "Rewind: Remove Intent Marker"
      },
      {
        "command": "rewind.removeCustomIntentCategory",
        "title": "Rewind: Delete Custom Intent Category"
        "command": "rewind.markAsPasted",
        "title": "Rewind: Mark Selection as Pasted"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "fast-levenshtein": "^3.0.0"
  }
}
