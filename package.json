{
  "name": "rewind",
  "publisher": "ReWind2027",
  "displayName": "Rewind",
  "description": "Supercharge your code with easier documentation",
  "repository": {"type": "git", "url": "[https://github.com/RhutvikH/Rewind](https://github.com/RhutvikH/Rewind)"},
  "version": "1.0.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "media",
    "node_modules",
    "LICENSE"
  ],
  "contributes": {
    "configuration": {
      "title": "Rewind",
      "properties": {
        "rewind.intentMarkerColor": {
          "type": "string",
          "default": "rgba(255, 255, 0, 0.2)",
          "description": "Background highlight color for intent markers."
        },
        "rewind.customIntentCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of custom intent categories."
        }
      }
    },
    "commands": [
      {
        "command": "rewind.analyzeImpact",
        "title": "Rewind: Analyze Change Impact on Active File"
      },
      {
        "command": "rewind.showImpactResults",
        "title": "Rewind: Show Impact Analysis Results"
      },
      {
        "command": "rewind.clearImpactAlerts",
        "title": "Rewind: Clear All Impact Alerts"
      },
      {
        "command": "rewind.startGhostRewrite",
        "title": "Rewind: Start Ghost Rewrite"
      },
      {
        "command": "rewind.acceptGhostRewrite",
        "title": "Rewind: Accept Ghost Rewrite"
      },
      {
        "command": "rewind.discardGhostRewrite",
        "title": "Rewind: Discard Ghost Rewrite"
      },
      {
        "command": "rewind.addIntentMarker",
        "title": "Rewind: Add Intent Marker"
      },
      {
        "command": "rewind.removeIntentMarker",
        "title": "Rewind: Remove Intent Marker"
      },
      {
        "command": "rewind.removeCustomIntentCategory",
        "title": "Rewind: Delete Custom Intent Category"
      },
      {
        "command": "rewind.markAsPasted",
        "title": "Rewind: Mark Selection as Pasted"
      },
      {
        "command": "rewind.toggleHeatmap",
        "title": "Rewind: Toggle Cognitive Load Heatmap"
      },
      {
        "command": "rewind.showGraph",
        "title": "Rewind: Show Code Graph"
      },
      {
        "command": "rewind.startRecording",
        "title": "Rewind: Start Thought Recording"
      },
      {
        "command": "rewind.stopRecording",
        "title": "Rewind: Stop Thought Recording"
      },
      {
        "command": "rewind.playForLine",
        "title": "Rewind: Play Explanation For This Line"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "fast-levenshtein": "^3.0.0",
    "mic": "^2.1.2",
    "node-record-lpcm16": "^1.0.1"
  }
}