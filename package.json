{
  "name": "rewindtrial",
  "displayName": "RewindTrial",
  "description": "Code review software",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:rewind.showGraph",
    "onCommand:rewind.startRecording",
    "onCommand:rewind.stopRecording",
    "onCommand:rewind.playForLine"
  ],
  "main": "./out/extension.js",
  "files": [
  "out",
  "media" 
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "rewind.showGraph",
        "title": "Rewind: Show Code Graph"
      },
      {
        "command": "rewind.startRecording",
        "title": "Rewind: Start Thought Recording"
      },
      {
        "command": "rewind.stopRecording",
        "title": "Rewind: Stop Thought Recording"
      },
      {
        "command": "rewind.playForLine",
        "title": "Rewind: Play Explanation For This Line"
      }
    ]
  },
  "dependencies": {
    "mic": "^2.1.2",
    "node-record-lpcm16": "^1.0.1"
  }
}
